# IP HTTPS protected deployment for AI Desk Card.
# The certificate is a Let's Encrypt shortlived IP certificate.
# Required environment variables when rendering this template:
# - AI_DESK_CARD_AUTH_USER: Basic Auth username
# - AI_DESK_CARD_AUTH_HASH: output from `caddy hash-password`
{
	auto_https off
}

:80 {
	root * /srv/ai-desk-card-online

	route {
		@acme path /.well-known/acme-challenge/*
		handle @acme {
			file_server
		}

		redir https://{host}{uri} permanent
	}
}

:443 {
	tls /etc/caddy/certs/ai-desk-card-online/fullchain.pem /etc/caddy/certs/ai-desk-card-online/privkey.pem
	root * /srv/ai-desk-card-online

	header {
		Cache-Control "no-store"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=604800"
		X-Content-Type-Options "nosniff"
	}

	route {
		basic_auth {
			{$AI_DESK_CARD_AUTH_USER} {$AI_DESK_CARD_AUTH_HASH}
		}

		@blockedFiles path /README.md /widgets.example.json
		respond @blockedFiles 404

		file_server {
			hide .git .DS_Store README.md widgets.example.json
		}
	}
}
