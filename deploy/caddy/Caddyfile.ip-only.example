# IP-only public demo hardening for AI Desk Card.
# This intentionally does not enable Basic Auth because HTTP would transmit the
# password in plaintext. Do not use this mode for private data.
# Required: AI_DESK_CARD_WEB_ROOT, the absolute deployed static web root.

:80 {
	root * {$AI_DESK_CARD_WEB_ROOT}

	header {
		Cache-Control "no-store"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}

	route {
		@blockedFiles path /README.md /widgets.example.json
		respond @blockedFiles 404

		file_server {
			hide .git .DS_Store README.md widgets.example.json
		}
	}
}
