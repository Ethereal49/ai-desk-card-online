# Caddy >= 2.8 static deployment template for AI Desk Card.
# Replace environment variables on the server; do not commit real credentials.
#
# Required environment variables:
# - AI_DESK_CARD_DOMAIN: the HTTPS hostname, for example card.example.com
# - AI_DESK_CARD_WEB_ROOT: absolute path to this repo's web/ directory
# - AI_DESK_CARD_AUTH_USER: Basic Auth username
# - AI_DESK_CARD_AUTH_HASH: output from `caddy hash-password`
# - ACME_EMAIL: email for ACME account notices

{
	email {$ACME_EMAIL}
}

{$AI_DESK_CARD_DOMAIN} {
	root * {$AI_DESK_CARD_WEB_ROOT}

	encode zstd gzip

	header {
		Cache-Control "no-store"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}

	route {
		basic_auth {
			{$AI_DESK_CARD_AUTH_USER} {$AI_DESK_CARD_AUTH_HASH}
		}

		@blockedFiles path /README.md /widgets.example.json
		respond @blockedFiles 404

		file_server {
			hide .git .DS_Store README.md widgets.example.json
		}
	}
}
